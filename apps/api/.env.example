# --- Auth (Clerk) ---
CLERK_SECRET_KEY=

# --- Database (Supabase Postgres) ---
# Use the session-mode connection string (port 5432) for migrations,
# pooler (port 6543) for the running app.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Storage (resumes) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes

# --- LiveKit Cloud ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- GitHub OAuth app ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback

# --- Groq (resume summaries, report grading) ---
GROQ_API_KEY=

# --- Encryption key for stored GitHub tokens (Fernet) ---
TOKEN_ENCRYPTION_KEY=

# --- Shared secret for /internal routes (agent worker only) ---
INTERNAL_SERVICE_KEY=

# --- Web origin for CORS ---
WEB_ORIGIN=http://localhost:3000
